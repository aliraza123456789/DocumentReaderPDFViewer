<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AppFlows" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/black_200</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.AppsFlow.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->

        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/black_200</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="actionOverflowButtonStyle">@style/OverFlow</item>
        <item name="actionModeBackground">@android:color/transparent</item>
        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:outlineSpotShadowColor" tools:ignore="NewApi">@color/blue_700</item>
        <item name="colorControlHighlight">@color/blue_100</item>
        <item name="snackbarStyle">@style/ThemeOverlay.App.SnackBar</item>
        <item name="snackbarTextViewStyle">@style/SnackBarText</item>

        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

    </style>

    <style name="Theme.AppFlows.AdTheme">
        <item name="android:background">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
    </style>

    <style name="Theme.AppFlows.AdAttribution">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:text">@string/ad_attribution</item>
        <item name="android:background">#FFCC66</item>
    </style>

    <style name="ratingBarNative" parent="@android:style/Widget.RatingBar">
        <item name="android:minHeight">15dp</item>
        <item name="android:maxHeight">15dp</item>
        <item name="colorControlNormal">@color/black_500</item>
        <item name="colorControlActivated">@color/blue_700</item>
    </style>

    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>


    <style name="OverFlow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="srcCompat">@drawable/ic_more_options</item>
        <item name="android:src">@drawable/ic_more_options</item>
    </style>

    <style name="Theme.AppsFlow.Home" parent="Theme.AppsFlow.NoActionBar">
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="mTheme.ToolbarAppearanceWhite" parent="Theme.AppsFlow.NoActionBar">
        <item name="android:textColorSecondary">@color/white</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="searchViewStyle">@style/mTheme.ToolbarSearchView</item>
        <item name="colorControlHighlight">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="mTheme.ToolbarTitleTextAppearance" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="fontFamily">@font/font_aileron_regular</item>
        <item name="android:textSize">@dimen/_18sdp</item>
        <item name="autoSizeMaxTextSize">@dimen/_18sdp</item>
        <item name="autoSizeMinTextSize">@dimen/_10sdp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="mTheme.ToolbarSearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/transparent</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="searchHintIcon">@null</item>
    </style>

    <style name="mTheme.TransparentProgressDialog" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="mTheme.DialogDefault" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:progressBarStyleSmall">@dimen/_30sdp</item>
        <item name="colorAccent">?attr/colorPrimaryVariant</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TitleTextStyle</item>
