<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_files_reader"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:paddingBottom="@dimen/_7sdp"
    android:layout_height="match_parent">


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tbAllFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_sv_arrow_back"
        app:navigationIconTint="@color/black"
        app:title="File Viewer" />

    <FrameLayout
        android:id="@+id/container_viewer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@+id/container_native_viewer_all"
        app:layout_constraintTop_toBottomOf="@+id/tbAllFiles">

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/container_native_viewer_all"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_95sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:gravity="center"
        android:minHeight="@dimen/_70sdp"
        app:cardBackgroundColor="?colorOnPrimary"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="@dimen/_2sdp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="@dimen/_70sdp"
        app:layout_constraintHeight_min="@dimen/_60sdp"
        app:strokeColor="@color/black_500"
        app:strokeWidth="0.8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="Advertisement Placement"
            android:textColor="@color/black"
            android:textSize="@dimen/_12sdp" />

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>