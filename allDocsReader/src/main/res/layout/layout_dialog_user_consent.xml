<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="clickHandler"
            type="android.view.View.OnClickListener" />

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_15sdp"
        android:paddingBottom="@dimen/_15sdp">

        <ScrollView
            android:id="@+id/scrollable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:scrollbars="vertical"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/btnConserContinue"
            app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_15sdp"
                android:paddingEnd="@dimen/_15sdp">

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/headConsentForm"
                    android:textColor="@color/black_700"
                    android:textSize="@dimen/_20sdp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvConsentHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:text="@string/descConsentOne"
                    android:textColor="@color/black_500"
                    android:textSize="@dimen/_12sdp"
                    app:layout_constraintEnd_toEndOf="@+id/textView9"
                    app:layout_constraintStart_toStartOf="@+id/textView9"
                    app:layout_constraintTop_toBottomOf="@+id/textView9" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="@dimen/_3sdp"
                    android:text="@string/descConsentTwo"
                    android:textColor="@color/black_200"
                    android:textSize="@dimen/_13sdp"
                    app:layout_constraintEnd_toEndOf="@+id/tvConsentHead"
                    app:layout_constraintStart_toStartOf="@+id/tvConsentHead"
                    app:layout_constraintTop_toBottomOf="@+id/tvConsentHead" />

            </LinearLayout>


        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConserContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/shape_button_primary_solid"
            android:elevation="@dimen/_3sdp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:onClick="@{(v)->clickHandler.onClick(v)}"
            android:text="@string/btnContinue"
            android:textAllCaps="true"
            android:textColor="@color/text_selector_button_solid"
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/btnConserExit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollable" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConserExit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/shape_button_primary_stroke"
            android:elevation="@dimen/_3sdp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:onClick="@{(v)->clickHandler.onClick(v)}"
            android:text="@string/exit"
            android:textAllCaps="true"
            android:textColor="@color/text_selector_button_stroke"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/btnConserContinue"
            app:layout_constraintStart_toEndOf="@id/btnConserPrivacy" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConserPrivacy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:background="@drawable/shape_button_primary_stroke"
            android:elevation="@dimen/_3sdp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:onClick="@{(v)->clickHandler.onClick(v)}"
            android:text="@string/bt_read_privacy"
            android:textAllCaps="true"
            android:textColor="@color/text_selector_button_stroke"
            android:textSize="@dimen/_11sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnConserExit"
            app:layout_constraintStart_toStartOf="@+id/btnConserContinue" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>

