      android:fillColor="#FFFEF08A"
      android:pathData="M21.2,24.2 L26.3,29.3 L23.5,32.1 C23.2,32.4 22.8,32.5 22.4,32.3 L18.8,30.8 L21.2,24.2 Z"/>

  <!-- Pen Tip writing on the line -->
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M18.8,30.8 L16.8,33.8 C16.6,34.1 16.2,34.1 16.0,33.9 C15.9,33.7 15.9,33.4 16.1,33.2 L19.2,30.1 Z"/>

  <!-- Cursive Signature Stroke -->
  <path
      android:pathData="M13,37 C15,35 16,38 18,36 C20,33 22,38 25,36 C28,34 31,37 35,35"
      android:strokeLineJoin="round"
      android:strokeWidth="2.5"
      android:fillColor="#00000000"
      android:strokeColor="#FFFFFF"
      android:strokeLineCap="round"/>

